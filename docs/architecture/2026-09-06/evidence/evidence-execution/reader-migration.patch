+    assert _next(tmp_path, capsys)['item']['handle'] == '(anonymous)#3'
+    store = SnapshotStore(tmp_path / '.crapkit/crap.sqlite')
+    with closing(store._conn):
+        assert [claim['id'] for claim in store.open_claims()] == [other]
+
