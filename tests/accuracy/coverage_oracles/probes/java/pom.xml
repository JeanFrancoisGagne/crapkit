<?xml version="1.0" encoding="UTF-8"?>
<!-- The Java probe's Maven build. regenerate.py passes -DprobeOut so each
     scenario compiles, tests and reports into a build directory of its own,
     and names the JaCoCo goals on the command line: this pom binds no plugin. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>probe</groupId>
  <artifactId>probe</artifactId>
  <version>1.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <probeOut>${project.basedir}/target</probeOut>
  </properties>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${probeOut}</directory>
  </build>
</project>
